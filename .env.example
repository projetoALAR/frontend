# URL da API Nest (usada pelo proxy server-side em /api/backend e /api/auth/*)
# Local: http://localhost:3001
# Produção: URL HTTPS da API (Railway), ex.: https://alar-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001
# Override só no servidor (recomendado em produção; não vai para o browser)
# API_URL=https://alar-api.up.railway.app

# Deve espelhar AUTH_ALLOW_PUBLIC_REGISTER do backend
NEXT_PUBLIC_ALLOW_REGISTER=false

# Sentry (opcional — sem DSN o app segue normal)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Só em local: libera /sentry-test
NEXT_PUBLIC_SENTRY_ENABLE_TEST=false
# Token só no CI para upload de source maps (não expor no browser)
SENTRY_AUTH_TOKEN=

# Links da página de Ajuda (components/help/help-content.tsx)
NEXT_PUBLIC_FORUM_URL=https://github.com/discussions
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@alar.com.br
NEXT_PUBLIC_VIDEOS_URL=https://www.youtube.com
