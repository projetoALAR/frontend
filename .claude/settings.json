{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm run *)",
      "Bash(npx *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\mdmkr\\AppData\\Roaming\\npm\\caliber.cmd learn observe",
            "description": "Caliber: recording tool usage for session learning"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\mdmkr\\AppData\\Roaming\\npm\\caliber.cmd learn observe --failure",
            "description": "Caliber: recording tool failure for session learning"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\mdmkr\\AppData\\Roaming\\npm\\caliber.cmd learn observe --prompt",
            "description": "Caliber: recording user prompt for correction detection"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\mdmkr\\AppData\\Roaming\\npm\\caliber.cmd learn finalize --auto",
            "description": "Caliber: finalizing session learnings"
          }
        ]
      }
    ]
  }
}